{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soufmer",
  "version": "0.1.0",
  "identifier": "com.soufmer.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Soufmer",
        "width": 960,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"],
    "targets": "all"
  }
}
