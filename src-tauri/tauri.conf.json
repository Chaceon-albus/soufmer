{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soufmer",
  "version": "0.1.0",
  "identifier": "com.soufmer.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"],
    "targets": "all"
  }
}
